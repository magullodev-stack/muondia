{
  "name": "muondia-visual",
  "displayName": "Muondia · Explorador visual",
  "description": "Pantallas y recursos visuales propios de Muondia.",
  "publisher": "magullodev",
  "version": "0.1.0",
  "private": true,
  "engines": {
    "vscode": "^1.90.0"
  },
  "main": "./extension.js",
  "activationEvents": [
    "onStartupFinished"
  ],
  "contributes": {
    "views": {
      "explorer": [
        {
          "id": "muondia.visual",
          "name": "Muondia · Explorador visual"
        }
      ]
    },
    "commands": [
      {
        "command": "muondia.visual.refresh",
        "title": "Actualizar explorador",
        "icon": "$(refresh)"
      },
      {
        "command": "muondia.visual.hide",
        "title": "Ocultar capa",
        "icon": "$(eye-closed)"
      },
      {
        "command": "muondia.visual.show",
        "title": "Mostrar capa",
        "icon": "$(eye)"
      },
      {
        "command": "muondia.visual.replace",
        "title": "Sustituir imagen",
        "icon": "$(replace)"
      },
      {
        "command": "muondia.visual.openState",
        "title": "Abrir código de pantalla"
      }
    ],
    "menus": {
      "view/title": [
        {
          "command": "muondia.visual.refresh",
          "when": "view == muondia.visual",
          "group": "navigation"
        }
      ],
      "view/item/context": [
        {
          "command": "muondia.visual.hide",
          "when": "view == muondia.visual && viewItem == muondiaImageVisible",
          "group": "inline"
        },
        {
          "command": "muondia.visual.show",
          "when": "view == muondia.visual && viewItem == muondiaImageHidden",
          "group": "inline"
        },
        {
          "command": "muondia.visual.replace",
          "when": "view == muondia.visual && (viewItem == muondiaImageVisible || viewItem == muondiaImageHidden)",
          "group": "navigation"
        }
      ]
    }
  }
}
