{
  "name": "muondia-visual",
  "displayName": "Muondia · Explorador visual",
  "description": "Pantallas, estados y capas visuales editables de Muondia.",
  "publisher": "magullodev",
  "version": "0.1.0",
  "private": true,
  "engines": {
    "vscode": "^1.90.0"
  },
  "main": "./extension.js",
  "activationEvents": [
    "onView:muondia.visual",
    "onStartupFinished"
  ],
  "contributes": {
    "views": {
      "explorer": [
        {
          "id": "muondia.visual",
          "name": "MUONDIA · EXPLORADOR VISUAL",
          "visibility": "visible"
        }
      ]
    },
    "commands": [
      {
        "command": "muondia.visual.refresh",
        "title": "Actualizar explorador",
        "icon": "$(refresh)"
      },
      {
        "command": "muondia.visual.toggle",
        "title": "Mostrar u ocultar capa",
        "icon": "$(eye)"
      },
      {
        "command": "muondia.visual.replace",
        "title": "Sustituir imagen",
        "icon": "$(replace)"
      },
      {
        "command": "muondia.visual.restore",
        "title": "Restaurar imagen original",
        "icon": "$(history)"
      }
    ],
    "menus": {
      "view/title": [
        {
          "command": "muondia.visual.refresh",
          "when": "view == muondia.visual",
          "group": "navigation"
        }
      ],
      "view/item/context": [
        {
          "command": "muondia.visual.toggle",
          "when": "view == muondia.visual && viewItem == muondiaVisualAsset",
          "group": "inline@1"
        },
        {
          "command": "muondia.visual.replace",
          "when": "view == muondia.visual && viewItem == muondiaVisualAsset",
          "group": "inline@2"
        },
        {
          "command": "muondia.visual.restore",
          "when": "view == muondia.visual && viewItem == muondiaVisualAsset",
          "group": "2_modification@1"
        }
      ]
    }
  }
}
